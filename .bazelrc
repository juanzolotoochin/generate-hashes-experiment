common --incompatible_strict_action_env
# Never probe the host for a C/C++ compiler: the Go code is pure, and the Rust
# cache links with the hermetic LLVM toolchain.
common --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1
build --@rules_go//go/config:pure
build --incompatible_enable_cc_toolchain_resolution
build --host_platform=@llvm//platforms:linux_x86_64
build --platforms=@llvm//platforms:linux_x86_64

# Local, untracked settings (e.g. remote cache credentials).
try-import %workspace%/auto.bazelrc
