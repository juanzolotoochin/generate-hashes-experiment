"""hashbench: benchmark harness for Bazel target-selection tools.

Everything the benchmark runs is pinned here, except the custom Bazel under
test (and git, used to version the benchmark workspace).
"""

module(name = "hashbench")

bazel_dep(name = "rules_go", version = "0.64.2")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.27.2")

# The local remote cache (cmd/remotecache) is Rust, linked with the hermetic
# LLVM toolchain.
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "llvm", version = "0.8.19")

register_toolchains("@llvm//toolchain:all")

bazel_dep(name = "rules_rs", version = "0.1.0")

rust_toolchains = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains")
rust_toolchains.toolchain(
    edition = "2021",
    version = "1.97.1",
)
use_repo(rust_toolchains, "default_rust_toolchains")

register_toolchains("@default_rust_toolchains//...")

crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lock = "//cmd/remotecache:Cargo.lock",
    cargo_toml = "//cmd/remotecache:Cargo.toml",
    platform_triples = ["x86_64-unknown-linux-gnu"],
)
use_repo(crate, "crates")

http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

# Stock Bazel: used by bazel-diff, target-determinator and the oracle.
http_file(
    name = "stock_bazel",
    downloaded_file_path = "bazel",
    executable = True,
    sha256 = "7668a95db1250f12c40407251e4e203b4ec8bf39bc495d2f485b2d8c99048694",
    url = "https://github.com/bazelbuild/bazel/releases/download/9.2.0/bazel-9.2.0-linux-x86_64",
)

http_file(
    name = "bazel_diff",
    downloaded_file_path = "bazel-diff",
    executable = True,
    sha256 = "4c1e70c955a7a950fc0ce15d921e976078a5fd1571e423c05016cb6e7c433dac",
    url = "https://github.com/Tinder/bazel-diff/releases/download/v60.0.0/bazel-diff-rust-linux-amd64",
)

http_file(
    name = "target_determinator",
    downloaded_file_path = "target-determinator",
    executable = True,
    sha256 = "115e1c63d39e2cd0d0b011c9fadc80f059f021176a4ae0de2232cdd83b1f8011",
    url = "https://github.com/bazel-contrib/target-determinator/releases/download/v0.34.0/target-determinator.linux.amd64",
)

# Statically linked shell and userland. They are the only /bin and /usr/bin
# visible to build actions (hermetic sandbox) and the only tools on PATH for
# every process the harness starts.
http_file(
    name = "static_bash",
    downloaded_file_path = "bash",
    executable = True,
    sha256 = "64469a9512a00199c85622ec56f870f97d50457a4e06e0cfa39bae7adf0cc8f2",
    url = "https://github.com/robxu9/bash-static/releases/download/5.2.015-1.2.3-2/bash-linux-x86_64",
)

http_file(
    name = "static_busybox",
    downloaded_file_path = "busybox",
    executable = True,
    sha256 = "6e123e7f3202a8c1e9b1f94d8941580a25135382b99e8d3e34fb858bba311348",
    url = "https://busybox.net/downloads/binaries/1.35.0-x86_64-linux-musl/busybox",
)
